# ============================================================
# 复制本文件为 .env 后填入真实密钥。.env 已在 .gitignore 中，切勿提交。
# 填完运行：python scripts/check_keys.py
# ============================================================

# ---- 主用：DeepSeek ----
# 申请：https://platform.deepseek.com  → 左侧 API Keys → 创建
# base_url 固定为 https://api.deepseek.com （OpenAI 兼容格式，SDK 里不要再拼 /v1）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- 备用 1：智谱 GLM ----
# 申请：https://open.bigmodel.cn → 右上角控制台 → API 密钥管理 → 创建
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ---- 备用 2：阿里云百炼（通义千问）----
# 申请：https://bailian.console.aliyun.com → 右上角「密钥管理」/ API-KEY → 创建
# 必须先开通百炼服务，否则调用报 403
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- 本地成本闸门（元）。累计超过就中止脚本，防止调试循环烧钱 ----
COST_LIMIT_CNY=20.0
COST_LEDGER=.cost_ledger.jsonl

# ---- 主用模型的思考模式：disabled=省钱快（默认）/ enabled=推理强、贵且慢 ----
DEEPSEEK_THINKING=disabled
